#compdef worktree-harness
# zsh completion for worktree-harness

_worktree_harness() {
  local curcontext="$curcontext" state line
  local -a cmds
  cmds=(
    'new:create a runnable worktree off the base branch'
    'launch:create a worktree and run your agent in it'
    'merge:rebase + gate + fast-forward the default branch (never pushes)'
    'gc:preview or remove merged + clean + idle worktrees'
    'status:list worktrees (branch, ahead/behind, dirty, ports)'
    'init:scaffold a .harnessrc'
    'doctor:diagnose the environment and validate .harnessrc'
    'help:print help, or the help for one command'
    'version:print the version'
  )

  _arguments -C \
    '--cwd[run as if started in DIR]:directory:_directories' \
    '--dry-run[print the actions a command would take; change nothing]' \
    '--no-color[turn off color]' \
    '--help[print help]' \
    '--version[print the version]' \
    '1:command:->command' \
    '*::argument:->argument'

  case "$state" in
    command)
      _describe -t commands 'worktree-harness command' cmds
      ;;
    argument)
      case "${words[1]}" in
        new|launch|init) _arguments '--dry-run[preview without changing anything]' '--help[show help]' ;;
        merge)           _arguments '--no-verify[skip the merge gate]' '--dry-run[preview]' '--help[show help]' ;;
        gc)              _arguments '--prune[remove the worktrees that pass every check]' \
                                    '--dry-run[preview only, even with --prune]' \
                                    '(-y --yes)'{-y,--yes}'[accepted for scripts; never removes on its own]' \
                                    '--help[show help]' ;;
        status)          _arguments '--porcelain[print tab-separated rows for scripts]' \
                                    '--json[print one JSON document]' \
                                    '--fields[with --json, keep only these keys]:fields:_values -s , field kind branch dirty ahead behind ports path' \
                                    '--help[show help]' ;;
        doctor)          _arguments '--help[show help]' ;;
        help)            _describe -t commands 'worktree-harness command' cmds ;;
      esac
      ;;
  esac
}

_worktree_harness "$@"
