root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts: 2-space indent (matches the project's house style).
[*.{sh,bash,bats}]
indent_style = space
indent_size = 2

# The dispatcher has no extension.
[worktree-harness]
indent_style = space
indent_size = 2

[*.fish]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
